# La procédure de chiffrement travaille EN PLACE sur les fichiers .enc.yaml :
# aucune copie en clair n'est censée exister sur le disque (voir README).
# Ces règles sont un filet de sécurité, pas la protection principale.

# Noms utilisés par la procédure, au cas où un chiffrement échouerait à
# mi-chemin ou qu'un déchiffrement soit redirigé vers un fichier.
cloudflare-token.yaml
credentials.yaml
secrets.yaml
*.dec.yaml
*.plain.yaml

# Clés age. Elles n'ont rien à faire ici, mais une erreur de chemin est vite
# arrivée.
*.agekey
keys.txt

# Kubeconfig rapatrié du VPS pendant l'amorçage.
kubeconfig
*.kubeconfig

# Charts téléchargés par le générateur `helmCharts:` de kustomize.
#
# CECI EST UNE RÈGLE DE PRINCIPE, PAS UNE COMMODITÉ. `kustomize build
# --enable-helm` fait un `helm pull` et dépose le chart dans un répertoire
# `charts/` à côté de la kustomization — 198 fichiers pour teleport-cluster.
# Les committer vendoriserait le chart, ce que ce dépôt refuse explicitement
# (cf. « Aucun chart vendorisé » en tête du README). Le chart est retéléchargé
# à chaque rendu, ici comme dans le repo-server d'ArgoCD, et n'existe jamais
# que dans une copie de travail.
charts/

# Artefacts locaux
.DS_Store
*.swp
*~
